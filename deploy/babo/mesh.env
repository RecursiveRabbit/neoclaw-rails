# The Babo render's source for the D-12 two-pod layout.
# N-01's single mesh contract (subnet, gateway, router, endpoint) lives in
# `manager/network.env`; this file holds only what the Babo render needs, and it
# must not become a second "single source" — the values below are the ones the
# render passes, and the Router renderer reads the contract.
#
# Underlay: one network per peer, and the Router joins both (N-03: the Router is
# the only peer every pod shares). Two pods on one bridge would be switched, not
# routed, and the UI->Manager rule would never be consulted.

BABO_UI_ADDRESS=10.0.0.11
BABO_MANAGER_ADDRESS=10.0.0.12
BABO_UI_PORT=8843
BABO_API_PORT=8844
# The Router container is named by the Router render, not by this one.
BABO_ROUTER_CONTAINER=wg-router
BABO_UI_NETWORK=babo-ui-mesh
BABO_MANAGER_NETWORK=babo-manager-mesh

# Where the Manager's credential-provisioning service definitions live. The
# egress allow-list is rendered from this file, deny-by-default: a service with
# no port is a render failure, not a silent hole.
BABO_SERVICE_DEFINITIONS=infra/services.conf
BABO_EGRESS_SERVICES="git valley vikunja"
