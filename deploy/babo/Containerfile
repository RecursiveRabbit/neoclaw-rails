# Babo — the office control plane, in a pod.
#
# Topology (stated, because the proofs depend on it): the pod has its OWN
# network namespace with its own wg0 at 10.0.0.5, exactly like the Hub at
# 10.0.0.4. The host reaches it over the mesh — host wg -> Router forward ->
# babo's wg0 — so there is NO published host port and no shared namespace.
#
# Isolation properties:
#   - no podman/docker socket, no container-runtime client in the image
#   - no writable host path; at run time exactly ONE read-only mount,
#     /etc/wireguard, from $HOST_SPAWN_DIR/runtime/babo (per-boot key)
#   - no published port; the app binds the WG address only
#   - NET_ADMIN is scoped to this container's own namespace for wg0 (same as
#     the Hub) — not host networking, not host firewall
#   - NEOCLAW_MANAGER_URL is the only outbound dependency; unreachable shows
#     the UI's `unknown` banner
#
# Build (from a checkout of the Babo office slice; the build context is the
# Babo source root, not this directory):
#   podman build -t localhost/neoclaw-babo:latest -f deploy/babo/Containerfile <babo-src>

# ---------- stage 1: frontend bundle (babo/web/dist) ----------
# babo/webui/build.py serves the built bundle from babo/web/dist, and the
# source tree ships no dist — the image must build it. Bun's lockfile is
# authoritative; the build script is `tsc -p tsconfig.build.json && vite build`
# (webui/package.json), and vite writes ../babo/web/dist (webui/vite.config.ts).
FROM oven/bun:1.2-slim AS web

WORKDIR /src
COPY webui/package.json webui/bun.lock ./
RUN bun install --frozen-lockfile
COPY webui/ ./
RUN bun run build && test -f /src/babo/web/dist/index.html

# ---------- stage 2: runtime ----------
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      wireguard-tools iproute2 curl tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The hatch build hook (hatch_build.py) bundles docs/ into the babo-document
# skill and REQUIRES docs/README.md — a wheel built without it fails. The
# webui bundle comes from stage 1 and is placed where the hook expects a
# prebuilt dist, so the hook's own UI build is skipped by env, not by luck.
COPY pyproject.toml hatch_build.py README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY docs/ ./docs/
COPY babo/ ./babo/
COPY --from=web /src/babo/web/dist ./babo/web/dist
ENV BABO_SKIP_WEBUI_BUILD=1
RUN pip install --no-cache-dir .
ENV BABO_SKIP_WEBUI_BUILD=

# The installed package (site-packages/babo) is what runs. Place the bundle
# there explicitly instead of trusting the build backend's file selection, then
# prove it: an image that installs cleanly and serves no UI must fail here, not
# in a browser.
RUN python3 -c "import os, shutil, babo.web; dst = os.path.join(os.path.dirname(babo.web.__file__), 'dist'); shutil.rmtree(dst, ignore_errors=True); shutil.copytree('/app/babo/web/dist', dst)" \
 && python3 -c "import os, babo.web; p = os.path.join(os.path.dirname(babo.web.__file__), 'dist', 'index.html'); assert os.path.isfile(p) and os.path.getsize(p) > 0, p; print('web bundle:', p)" \
 && rm -rf /app/babo

# The entrypoint lives here, not in a separate file: the build context is the
# Babo source root, and COPY cannot reach outside it. One artifact, no staged
# context, and no second copy to drift. (Heredoc RUN needs a modern builder:
# podman >= 4.6 / buildah >= 1.31.)
RUN cat > /usr/local/bin/babo-entrypoint <<'ENTRY'
#!/bin/bash
set -eu

# Babo in a pod: bring up its own WG interface, make the UI bind that address
# only, and run the gateway in the FOREGROUND (the container's main process).
#
# Why `babo gateway` and not `babo webui`: `babo webui` is a client launcher --
# it starts a *background* gateway, opens (or suppresses) a browser, attaches to
# the gateway log, and returns; with tini as PID 1 the container would exit and
# take the service with it. `babo gateway` (no --background) runs the server in
# this process's foreground, which is what a pod needs. Recorded deviation.
#
# Why a rendered config: the bind address is not a CLI flag (there is no --host);
# it comes from config.gateway.host (babo/config/schema.py, default 127.0.0.1).
# The bind address is the address the Router admits, so it is read from the
# interface itself rather than hardcoded or defaulted.

log() { echo "[babo] $*"; }

if [ ! -f /etc/wireguard/wg0.conf ]; then
    log "FATAL: /etc/wireguard/wg0.conf not mounted (per-boot key missing)"
    exit 1
fi

wg-quick up wg0 || { log "FATAL: wg-quick failed"; exit 1; }

# The effective bind address is a fact read from wg0, not an assumption. The
# Router rule admits 10.0.0.5 only, so a different address is a loud failure
# rather than a page nobody can reach.
BIND="$(ip -4 -o addr show dev wg0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
if [ -z "${BIND}" ]; then
    log "FATAL: wg0 came up with no IPv4 address; nothing to bind"
    exit 1
fi
if [ "${BIND}" != "10.0.0.5" ]; then
    log "FATAL: wg0 address is ${BIND}, but the Router admits 10.0.0.5 only; refusing to bind an address that cannot be reached"
    exit 1
fi
log "wireguard up (${BIND})"

PORT="${BABO_PORT:-8843}"
CONFIG="${BABO_RUNTIME_CONFIG:-/run/babo/config.json}"
mkdir -p "$(dirname "$CONFIG")"
cat > "$CONFIG" <<EOF
{
  "gateway": {
    "host": "${BIND}",
    "port": ${PORT}
  }
}
EOF
log "runtime config: ${CONFIG} (gateway.host=${BIND}, gateway.port=${PORT})"

# The Manager endpoint is the ONLY outbound dependency. Unreachable -> the UI
# shows its unknown banner; nothing falls back to a local path.
log "manager endpoint: ${NEOCLAW_MANAGER_URL:-unset}"
log "office backend:   ${NEOCLAW_OFFICE_BACKEND:-manager}"

exec babo gateway --config "$CONFIG" --port "$PORT"
ENTRY
RUN chmod +x /usr/local/bin/babo-entrypoint

ENV BABO_PORT=8843 \
    NEOCLAW_OFFICE_BACKEND=manager \
    NEOCLAW_MANAGER_URL=http://10.0.0.3:9200 \
    PYTHONUNBUFFERED=1

# Documentation only. Nothing is published at run time by this image.
EXPOSE 8843

# Probe the address the app actually binds. A loopback probe would only ever
# report unhealthy and teach us to ignore it.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf "http://10.0.0.5:${BABO_PORT}/health" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/babo-entrypoint"]
