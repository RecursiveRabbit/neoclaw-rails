# Babo — the office control plane, in a pod.
#
# Topology (stated, because the proofs depend on it): the pod has its OWN
# network namespace with its own wg0 at 10.0.0.5, exactly like the Hub at
# 10.0.0.4. The host reaches it over the mesh — host wg -> Router forward ->
# babo's wg0 — so there is NO published host port and no shared namespace.
#
# Isolation properties (D-10, two containers from this one image):
#   - the image carries `podman-remote` and `git`; the runtime client is only
#     usable where the runtime socket is mounted, and that mount belongs to
#     `babo-core` alone. `babo-ui` gets neither the socket nor NET_ADMIN.
#   - no writable host path except the two the pod render declares: the
#     per-boot wg0 dir (read-only, core only) and the runtime socket (core
#     only). The internal Unix socket volume is shared by both containers.
#   - no published port; core binds the WG address only, ui binds loopback.
#   - CAP_NET_ADMIN is scoped to babo-core's own namespace for wg0 (same as
#     the Hub) — not host networking, not host firewall.
#   - no manager URL and no NeoClaw backend: the product is the manager.
#
# Build (from a checkout of the Babo office slice; the build context is the
# Babo source root, not this directory):
#   podman build -t localhost/neoclaw-babo:latest -f deploy/babo/Containerfile <babo-src>

# ---------- stage 1: frontend bundle (babo/web/dist) ----------
# babo/webui/build.py serves the built bundle from babo/web/dist, and the
# source tree ships no dist — the image must build it. The stage mirrors the
# monorepo layout (/repo/webui, /repo/babo, /repo/packages) because
# webui/vite.config.ts resolves its output as `../babo/web/dist` relative to
# its own directory; flattening webui/ to the root sends the bundle outside the
# tree and the build then fails its own test below.
FROM oven/bun:1.2-slim AS web

WORKDIR /repo
COPY packages/ ./packages/
COPY babo/channels ./babo/channels
COPY webui/package.json webui/bun.lock ./webui/
WORKDIR /repo/webui
RUN bun install --frozen-lockfile
COPY webui/ ./
RUN bun run build && test -f /repo/babo/web/dist/index.html

# ---------- stage 2: runtime ----------
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      wireguard-tools iproute2 curl tini git podman-remote \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The hatch build hook (hatch_build.py) bundles docs/ into the babo-document
# skill and REQUIRES docs/README.md — a wheel built without it fails. The
# webui bundle comes from stage 1 and is placed where the hook expects a
# prebuilt dist, so the hook's own UI build is skipped by env, not by luck.
COPY pyproject.toml hatch_build.py README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY docs/ ./docs/
COPY babo/ ./babo/
COPY --from=web /repo/babo/web/dist ./babo/web/dist
ENV BABO_SKIP_WEBUI_BUILD=1
RUN pip install --no-cache-dir .
ENV BABO_SKIP_WEBUI_BUILD=

# The installed package (site-packages/babo) is what runs. Resolve it from `/`,
# not from /app: with /app on the path, `import babo.web` resolves to the source
# tree that is about to be deleted, and the copy would delete its own source.
# Place the bundle in the installed package, prove it, then drop the source.
RUN cd / && python3 -c "import os, shutil, babo.web; dst = os.path.join(os.path.dirname(babo.web.__file__), 'dist'); shutil.rmtree(dst, ignore_errors=True); shutil.copytree('/app/babo/web/dist', dst)" \
 && python3 -c "import os, babo.web; p = os.path.join(os.path.dirname(babo.web.__file__), 'dist', 'index.html'); assert os.path.isfile(p) and os.path.getsize(p) > 0, p; print('web bundle:', p)" \
 && rm -rf /app/babo

# The entrypoint is embedded as base64, not a heredoc RUN: buildah 1.33 on
# z620 (podman 4.9) cannot parse heredocs, and the build must not depend on a
# newer builder. The readable source of truth is deploy/babo/entrypoint.sh;
# this blob is generated from it:
#   base64 -w0 deploy/babo/entrypoint.sh
# and the packaging check fails if the image's copy and that file ever differ.
RUN echo  | base64 -d > /usr/local/bin/babo-entrypoint \
 && chmod +x /usr/local/bin/babo-entrypoint

ENV BABO_PORT=8843 \
    PYTHONUNBUFFERED=1

# Documentation only. Nothing is published at run time by this image.
EXPOSE 8843

# Probe the address the app actually binds. A loopback probe would only ever
# report unhealthy and teach us to ignore it.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf "http://10.0.0.5:${BABO_PORT}/health" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/babo-entrypoint"]
