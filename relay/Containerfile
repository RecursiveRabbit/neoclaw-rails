# The stock agent container image.
# Every agent — Silas, Margaux, Kael, everyone — uses this same image.
# Identity comes from spawn.json, not the image.

FROM docker.io/library/ruby:3.3-slim

RUN apt-get update && apt-get install -y \
    wireguard-tools \
    openssh-client \
    git \
    curl \
    build-essential \
    nodejs \
    npm \
    iproute2 \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
RUN bundle install

COPY relay.rb .
RUN chmod +x relay.rb

# Create agent user — Claude Code refuses to run as root
RUN useradd -m -s /bin/bash agent
RUN mkdir -p /workspace && chown agent:agent /workspace

# spawn.json is mounted at /run/secrets/spawn.json by the Manager
# WireGuard is configured by the relay on boot

EXPOSE 9300

CMD ["ruby", "relay.rb"]
