# The stock agent container image.
# Every agent — Silas, Margaux, Kael, everyone — uses this same image.
# Identity comes from spawn.json, not the image.
#
# Boot sequence:
#   entrypoint.sh (root) → WireGuard, credentials, SSH keys, MCP config
#   exec gosu agent ruby relay.rb → HTTP server + Claude Code

FROM docker.io/library/ruby:3.3-slim

RUN apt-get update && apt-get install -y \
    wireguard-tools \
    openssh-client \
    git \
    curl \
    build-essential \
    nodejs \
    npm \
    iproute2 \
    iputils-ping \
    gosu \
    tini \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Install MCP dependencies in a venv (avoids pip externally-managed error)
RUN python3 -m venv /opt/mcp-env && \
    /opt/mcp-env/bin/pip install --no-cache-dir mcp paramiko

# Create agent user — Claude Code refuses to run as root
RUN useradd -m -s /bin/bash agent
RUN mkdir -p /workspace && chown agent:agent /workspace

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
RUN bundle install

COPY relay.rb .
COPY entrypoint.sh .
RUN chmod +x relay.rb entrypoint.sh

# MCP servers — available to all agents
COPY mcp/ /opt/mcp/

# spawn.json is mounted at /run/secrets/spawn.json by the Manager
# claude-credentials is mounted at /run/secrets/claude-credentials

EXPOSE 9300

# tini reaps zombie processes from Claude Code's tool calls
ENTRYPOINT ["tini", "--", "/app/entrypoint.sh"]
