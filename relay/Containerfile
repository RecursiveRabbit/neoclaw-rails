# The stock agent container image.
# Every agent — Silas, Margaux, Kael, everyone — uses this same image.
# Identity comes from spawn.json, not the image.

FROM ruby:3.3-slim

RUN apt-get update && apt-get install -y \
    wireguard-tools \
    openssh-client \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code
RUN curl -fsSL https://claude.ai/install.sh | sh

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
RUN bundle install

COPY relay.rb .
RUN chmod +x relay.rb

# The workspace where the agent clones their repo
RUN mkdir -p /workspace

# spawn.json is mounted at /run/secrets/spawn.json by the Manager
# WireGuard is configured by the relay on boot

EXPOSE 9300

CMD ["ruby", "relay.rb"]
