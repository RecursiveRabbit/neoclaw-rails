<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-stone-200 text-xl font-medium">#<%= @room.channel %></h1>
    <div class="flex gap-2">
      <%= link_to "edit", edit_room_config_path(@room), class: "text-sm px-3 py-1.5 rounded bg-stone-800 text-stone-400 hover:text-amber-400 transition-colors" %>
      <%= button_to "delete", room_config_path(@room), method: :delete, class: "text-sm px-3 py-1.5 rounded bg-stone-800 text-stone-400 hover:text-red-400 transition-colors", data: { turbo_confirm: "Delete ##{@room.channel}?" } %>
    </div>
  </div>

  <%# Details %>
  <div class="bg-stone-900 border border-stone-800 rounded-lg p-4 grid grid-cols-2 gap-4 text-sm">
    <div>
      <div class="text-stone-500 text-xs uppercase tracking-wider mb-1">model default</div>
      <div class="text-stone-300"><%= @room.model_default.presence || "inherit from agent" %></div>
    </div>
    <div>
      <div class="text-stone-500 text-xs uppercase tracking-wider mb-1">extra services</div>
      <div class="text-stone-300"><%= @room.extra_services.presence&.join(", ") || "none" %></div>
    </div>
  </div>

  <%# Services granted to everyone in this room %>
  <div class="bg-stone-900 border border-stone-800 rounded-lg p-4">
    <h2 class="text-amber-500 text-xs font-bold uppercase tracking-wider mb-3">room services</h2>
    <p class="text-stone-500 text-xs mb-3">Every agent spawned in #<%= @room.channel %> gets these on top of their base services.</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
      <% @services.each do |svc| %>
        <% enabled = @room.has_service?(svc.name) %>
        <div class="flex items-center gap-3 p-2 rounded">
          <div class="w-5 h-5 rounded border-2 flex items-center justify-center <%= enabled ? 'border-amber-500 bg-amber-500/20' : 'border-stone-700' %>">
            <% if enabled %>
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            <% end %>
          </div>
          <div>
            <div class="text-stone-300 text-sm"><%= svc.name %></div>
            <div class="text-stone-600 text-xs"><%= svc.provision_type %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Agent-specific overrides for this room %>
  <div class="bg-stone-900 border border-stone-800 rounded-lg p-4">
    <h2 class="text-amber-500 text-xs font-bold uppercase tracking-wider mb-3">agent overrides</h2>
    <p class="text-stone-500 text-xs mb-3">Specific agents that get additional services in this room.</p>

    <% if @overrides.any? %>
      <div class="space-y-2 mb-4">
        <% @overrides.each do |ovr| %>
          <div class="flex items-center justify-between py-2 border-b border-stone-800/50">
            <div>
              <span class="text-stone-300 text-sm font-medium"><%= ovr.agent_config.identity %></span>
              <div class="flex gap-1.5 mt-1">
                <% (ovr.extra_services || []).each do |svc| %>
                  <span class="text-xs px-1.5 py-0.5 rounded bg-stone-800 text-stone-400">+<%= svc %></span>
                <% end %>
              </div>
            </div>
            <%= link_to "edit", edit_agent_config_agent_room_config_path(ovr.agent_config, ovr), class: "text-xs text-stone-500 hover:text-amber-400" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-stone-600 text-xs mb-3">No agent-specific overrides for this room.</div>
    <% end %>
  </div>

  <% if @room.notes.present? %>
    <div class="bg-stone-900 border border-stone-800 rounded-lg p-4">
      <h2 class="text-amber-500 text-xs font-bold uppercase tracking-wider mb-2">notes</h2>
      <div class="text-stone-400 text-sm whitespace-pre-wrap"><%= @room.notes %></div>
    </div>
  <% end %>
</div>
