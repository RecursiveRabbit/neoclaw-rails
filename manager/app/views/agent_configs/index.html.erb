<div class="flex items-center justify-between mb-6">
  <h1 class="text-amber-500 text-sm font-bold uppercase tracking-wider">agent configs</h1>
  <%= link_to "new identity", new_agent_config_path, class: "text-sm px-3 py-1.5 rounded bg-amber-900/30 border border-amber-700/30 text-amber-500 hover:bg-amber-900/50 transition-colors" %>
</div>

<div class="space-y-3">
  <% @configs.each do |cfg| %>
    <%= link_to agent_config_path(cfg), class: "block bg-stone-900 border border-stone-800 rounded-lg p-4 hover:border-stone-700 transition-colors" do %>
      <div class="flex items-center justify-between">
        <div>
          <span class="text-stone-200 font-medium"><%= cfg.identity %></span>
          <span class="text-stone-600 text-sm ml-2"><%= cfg.repo %></span>
          <% if cfg.singleton? %>
            <span class="text-amber-600 text-xs ml-2 border border-amber-800/30 rounded px-1">singleton</span>
          <% end %>
        </div>
        <div class="text-stone-500 text-sm">
          <%= cfg.model&.split("-")&.last(2)&.join(" ") %>
        </div>
      </div>
      <div class="mt-2 flex gap-2 flex-wrap">
        <% (cfg.base_services || []).each do |svc| %>
          <span class="text-xs px-2 py-0.5 rounded-full bg-stone-800 text-stone-400"><%= svc %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
