# The mesh underlay — ONE source for these five values.
#
# Sourced by manager/entrypoint.sh, manager/run.sh, manager/build.sh and
# manager/mesh-network.sh, read by manager/config/initializers/surface.rb, and
# sourced by the host scripts under infra/. Nothing else in this repo may name
# a mesh address: the repo-wide guard in
# manager/test/contracts/podman_launch_network_test.rb fails on a stray
# 10.88/10.89 literal in executable code.
#
# Why a user-defined network and not podman's default bridge:
#   * rootless podman defaults to pasta/slirp4netns, where `--ip` is refused
#     outright ("networks and static ip/mac address can only be used with
#     Bridge mode networking") and a container on the default network cannot
#     reach a container on a bridge at all. Measured on z620 (podman 4.9.3,
#     netavark): `nc -z <bridge peer> 19999` UNREACHABLE from default
#     networking, REACHABLE with an explicit `--network`.
#   * the default `podman` bridge already owns 10.88.0.0/16 on the deployment
#     host, and a user-defined network cannot overlap it, so the mesh got its
#     own subnet rather than borrowing a host default.
#
# Historical values, superseded on 2026-11-10 (kept named, not erased):
#   subnet/gateway 10.88.0.0/16, 10.88.0.1 — the podman default bridge
#   Router underlay address 10.88.0.20, WG endpoint 10.88.0.20:51820
# They remain valid history for anything recorded before this date; they are no
# longer values this code uses.

# Name of the podman network the mesh rides on. Created and inspected at boot.
NC_MESH_NETWORK=neoclaw-mesh

# The mesh underlay subnet and its gateway on the host side of the bridge.
NC_MESH_SUBNET=10.89.0.0/16
NC_MESH_GATEWAY=10.89.0.1

# The Router's static underlay address inside that network, and the endpoint
# every WG peer dials (Router IP + WG port 51820).
ROUTER_BRIDGE_IP=10.89.0.20
ROUTER_ENDPOINT=10.89.0.20:51820
