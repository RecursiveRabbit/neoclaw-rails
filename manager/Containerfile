# NeoClaw Manager — the orchestrator. Runs inside a container.
#
# Launches the Router and Hub on boot, reconciles orphaned agent pods.
# All WG keys are generated per boot; nothing key-shaped is baked.
#
# Runtime mounts:
#   /run/podman/podman.sock        — podman socket (create/destroy pods)
#   /spawn                         — spawn.json staging
#   /ssh-keys                      — agent SSH keys
#   /data                          — persistent SQLite database
#   /run/secrets/claude-credentials — Claude OAuth creds (refreshes hourly)

FROM ruby:3.3-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wireguard-tools \
    iproute2 \
    openssh-client \
    sqlite3 \
    libsqlite3-dev \
    libyaml-dev \
    pkg-config \
    build-essential \
    curl \
    tini \
    podman-remote \
    && ln -sf /usr/bin/podman-remote /usr/bin/podman \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
COPY vendor/bundle vendor/bundle
RUN bundle config set --local path vendor/bundle \
    && bundle config set --local without 'development test' \
    && bundle install --local

# NO WG private key or Router pubkey is baked. The entrypoint generates
# per-boot keys and renders configs into /spawn/runtime. Only public
# inputs are baked here:
#   nc-host.pub             — the host's persistent pubkey
#   users-peers.fragment    — 10.2.x user pubkeys (public)
#   router-services.yml     — service port map the Router config appends
RUN mkdir -p /etc/wireguard /etc/neoclaw
COPY nc-host.pub /etc/neoclaw/nc-host.pub
COPY users-peers.fragment /etc/neoclaw/users-peers.fragment
COPY services.yml /etc/neoclaw/router-services.yml
COPY build_config.sh /etc/neoclaw/build_config.sh
RUN chmod 644 /etc/neoclaw/nc-host.pub

COPY . .

RUN mkdir -p db tmp log storage
RUN SECRET_KEY_BASE=placeholder RAILS_ENV=production bundle exec rails assets:precompile
RUN chmod +x /app/entrypoint.sh

EXPOSE 9200

ENTRYPOINT ["tini", "--", "/app/entrypoint.sh"]
