FROM ruby:3.3-slim

RUN apt-get update && apt-get install -y \
    wireguard-tools \
    openssh-client \
    sqlite3 \
    libsqlite3-dev \
    build-essential \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
RUN bundle install --without development test

COPY . .

RUN mkdir -p db tmp log storage

EXPOSE 9200

CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "9200"]
