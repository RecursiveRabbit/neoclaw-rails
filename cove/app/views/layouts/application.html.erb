<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cove Manager</title>
  <style>
    :root {
      --ink:#101418; --dim:#5b6672; --line:#d8dee6; --bg:#f6f7f9; --card:#fff;
      --go:#1f6f3f; --warn:#8a4b00; --stop:#8d1f1f; --seam:#1b3f6b;
    }
    * { box-sizing:border-box; }
    body { margin:0; font:15px/1.5 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
           color:var(--ink); background:var(--bg); }
    header { background:var(--ink); color:#fff; padding:.7rem 1.2rem; display:flex; gap:1.2rem;
             align-items:baseline; }
    header .brand { font-weight:700; letter-spacing:.02em; }
    header a { color:#cfe0f5; text-decoration:none; }
    header a:hover { text-decoration:underline; }
    header .right { margin-left:auto; color:#93a4b8; font-size:13px; }
    main { max-width:60rem; margin:1.4rem auto 4rem; padding:0 1.2rem; }
    h1 { font-size:1.35rem; margin:.2rem 0 1rem; }
    h2 { font-size:1.05rem; margin:1.6rem 0 .6rem; }
    table { width:100%; border-collapse:collapse; background:var(--card); }
    th,td { text-align:left; padding:.5rem .6rem; border-bottom:1px solid var(--line); vertical-align:top; }
    th { font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--dim); }
    tr:last-child td { border-bottom:none; }
    code, pre { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:13px; }
    pre { background:#0e1420; color:#d7e3f4; padding:1rem; border-radius:6px; overflow:auto; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:6px; padding:1rem 1.1rem; }
    .muted { color:var(--dim); }
    .note { border-left:3px solid var(--go); background:#eef6f0; padding:.6rem .8rem; margin:0 0 1rem;
            border-radius:0 4px 4px 0; }
    .alert { border-left:3px solid var(--stop); background:#fbeeee; padding:.6rem .8rem; margin:0 0 1rem;
             border-radius:0 4px 4px 0; }
    .warn { border-left:3px solid var(--warn); background:#fdf3e6; padding:.6rem .8rem; margin:0 0 1rem;
            border-radius:0 4px 4px 0; }
    label { display:block; font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--dim);
            margin:.8rem 0 .25rem; }
    input[type=text], textarea { width:100%; padding:.45rem .55rem; border:1px solid var(--line);
            border-radius:4px; font:inherit; background:#fff; }
    textarea { min-height:3.2rem; font-family:ui-monospace,Menlo,monospace; font-size:13px; }
    button, .btn { display:inline-block; padding:.5rem .9rem; border-radius:4px; border:1px solid var(--line);
            background:#fff; color:var(--ink); font:inherit; cursor:pointer; text-decoration:none; }
    button.go { background:var(--go); border-color:var(--go); color:#fff; font-weight:600; }
    button.stop { background:#fff; border-color:var(--stop); color:var(--stop); }
    .checks { display:grid; grid-template-columns:repeat(auto-fill,minmax(13rem,1fr)); gap:.3rem .9rem;
              margin:.3rem 0 .2rem; }
    .checks label { text-transform:none; letter-spacing:0; font-size:14px; color:var(--ink); margin:.15rem 0;
                    display:flex; gap:.45rem; align-items:center; }
    .pill { display:inline-block; font-size:12px; padding:.1rem .45rem; border-radius:999px;
            background:#e7ecf3; color:var(--seam); }
    .bad { color:var(--stop); }
    .good { color:var(--go); }
    .facts td:first-child { width:11rem; font-family:ui-monospace,Menlo,monospace; font-size:13px; }
  </style>
</head>
<body>
<header>
  <span class="brand">COVE</span>
  <a href="<%= root_path %>">sheets</a>
  <a href="<%= pods_path %>">pods</a>
  <a href="<%= router_config_path %>">router.conf</a>
  <a href="<%= relay_wants_path %>">relay wants</a>
  <span class="right">the Manager knows sheets, pods, podman, and one file</span>
</header>
<main>
  <% if notice %><div class="note"><%= notice %></div><% end %>
  <% if alert %><div class="alert"><%= alert %></div><% end %>
  <%= yield %>
</main>
</body>
</html>
