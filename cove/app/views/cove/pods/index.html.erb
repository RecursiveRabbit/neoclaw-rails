<h1>Pods</h1>
<p class="muted">
  Read from podman at the moment this page rendered. Nothing on this page was stored:
  a pod that dies while you are reading it is already gone from the next load, and the page
  will not remember that it ever said otherwise.
</p>

<% if @error %>
  <div class="alert">podman could not be read: <%= @error %></div>
<% end %>

<form action="<%= destroy_all_pods_path %>" method="post" style="margin:1rem 0"
      onsubmit="return confirm('destroy the test pods (cove-test-*)? anything with another name is left standing, and the answer will name it.');">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <button class="go" type="submit">destroy the test pods</button>
  <span class="muted">the teardown row, as a button, scoped: <code>cove-test-*</code> gone, everything else
  left standing and named in the answer, Router emptied, addresses kept on the sheets.</span>
</form>

<form action="<%= destroy_all_pods_path %>" method="post" style="margin:1rem 0"
      onsubmit="return confirm('destroy EVERY pod this Manager launched, including anything a person made? the Router keeps its file and loses its peers. this one is not scoped.');">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="scope" value="all">
  <button type="submit">destroy every pod</button>
  <span class="muted">scope <code>all</code>: every pod carrying this Manager's label, fixtures or not. This is the one
  that needs a reason, so it is not the default and it says so.</span>
</form>

<table>
  <thead><tr><th>sheet</th><th>pod</th><th>image</th><th>status (as podman reports it)</th><th>created</th><th></th></tr></thead>
  <tbody>
  <% if @pods.empty? %>
    <tr><td colspan="6" class="muted">nothing running. A sheet is not a pod.</td></tr>
  <% end %>
  <% @pods.each do |pod| %>
    <% slug = agent_label(pod); sheet = @sheets[slug] %>
    <tr>
      <td>
        <% if sheet %>
          <a href="<%= pod_path(slug) %>"><strong><%= sheet.name %></strong></a><br>
          <code class="muted"><%= slug %></code>
        <% else %>
          <span class="bad">no sheet</span><br><code class="muted"><%= slug.presence || "(unlabelled)" %></code>
        <% end %>
      </td>
      <td><code><%= container_name(pod) %></code></td>
      <td><code class="muted"><%= pod["Image"] %></code></td>
      <td><%= pod["Status"] %></td>
      <td class="muted"><%= pod["Created"] %></td>
      <td>
        <form action="<%= pod_path(slug) %>/stop" method="post" style="display:inline">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button class="stop" type="submit">stop</button>
        </form>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>

<% if @orphans.any? %>
  <div class="warn">
    <%= @orphans.size %> pod(s) carry this Manager's label but no current sheet claims them.
    That is what deleting a sheet while its pod ran looks like. They are not stopped for you:
    stopping something because its paperwork is missing would be the Manager inventing intent.
  </div>
<% end %>
