#!/usr/bin/env ruby
# frozen_string_literal: true

# The acceptance suite — spec §15, Evans 2026-11-20 ("we need a test suite").
#
#   ./script/acceptance              run every row
#   ./script/acceptance 7 8 9        run only those rows
#   ./script/acceptance --list       the row map
#   ./script/acceptance --prove-instrument
#                                    prove the two failures this suite must never
#                                    hide can actually fail it
#
# Three laws, and they are the reason this file exists rather than a shell script:
#
#   1. GREEN ONLY AGAINST THE REAL SYSTEM. A missing prerequisite is UNMET with the
#      reason (never a skip, never a pass). Nothing is mocked, stubbed or replayed.
#   2. INSTRUMENTS, NOT GREP. Rules are read with `iptables-save` from inside the
#      namespace; peers with `wg show` from a namespace that can answer; reachability
#      with a real connection; packets by arriving or not arriving.
#   3. TWO FAILURES IT MUST NEVER HIDE:
#        - a rule that exists but carries no packet   -> rows assert traffic, and a
#          config-layer reading is labelled CONFIG, never MET.
#        - a packet that crosses where no rule permits it -> the refusal rows assert a
#          real connection FAILS *and* that no rule allows it.
#      `--prove-instrument` builds both situations on purpose and requires this suite
#      to catch each one. A guard that cannot fail is the defect.
#
# It runs against a clone, never a working copy (the slice-one lesson is row zero):
# a dirty tree or an unrecorded head is a FAIL before any system row is attempted.

require "open3"
require "json"
require "time"

REF   = ENV.fetch("COVE_REF", File.expand_path("../..", __dir__)).freeze
MGMT  = ENV.fetch("COVE_MANAGER", "http://127.0.0.1:9411").freeze
HOST  = ENV.fetch("COVE_HOST", "z620").freeze
ROUTER = ENV.fetch("COVE_ROUTER_NAME", "cove-router").freeze
NOW = Time.now.utc.iso8601

ROWS = []

def say(id, status, detail)
  ROWS << [id, status, detail]
  printf("%-4s %-7s %s\n", id, status, detail)
end
def met(id, d)  = say(id, "MET", d)
def fail!(id, d) = say(id, "FAIL", d)
def unmet(id, d) = say(id, "UNMET", d)
def config(id, d) = say(id, "CONFIG", d) # proven by reading, not by a packet

def sh(cmd, timeout: 15)
  out, err, st = Open3.capture3("timeout", timeout.to_s, "bash", "-lc", cmd)
  [out.to_s, err.to_s, st.success?]
end

def sudo_sh(cmd, timeout: 15) = sh("sudo -n #{cmd}", timeout: timeout)

# ---- instruments -----------------------------------------------------------
# The Router runs in its own netns; nothing inside it can read its own wg state
# (measured: `wg set` works over netlink in a userns, `wg show` reads sysfs and
# cannot). So every Router reading is taken from the HOST, with nsenter.
def router_pid
  out, = sh("sudo -n podman inspect #{ROUTER} --format '{{.State.Pid}}' 2>/dev/null")
  out.strip
end

def in_router(cmd, timeout: 15)
  pid = router_pid
  return [nil, "no Router pod named #{ROUTER}", false] if pid.empty? || pid == "0"
  sudo_sh("nsenter -t #{pid} -n #{cmd}", timeout: timeout)
end

def nsented(path, cmd, timeout: 15)
  sudo_sh("nsenter --net=#{path} #{cmd}", timeout: timeout)
end

def pod_netns(name)
  out, = sh("sudo -n podman inspect #{name} --format '{{.State.Pid}}' 2>/dev/null")
  pid = out.strip
  (pid.empty? || pid == "0") ? nil : "/proc/#{pid}/ns/net"
end

def podman_names
  out, = sh("sudo -n podman ps --format '{{.Names}}'")
  out.split("\n").map(&:strip).reject(&:empty?)
end

def http(path, method: "GET", data: nil, timeout: 10)
  url = "#{MGMT}#{path}"
  if method == "GET"
    out, err, st = sh("curl -sS -o /tmp/acc.body -w '%{http_code}' --max-time #{timeout} '#{url}'", timeout: timeout + 2)
    [out.strip.to_i, File.exist?("/tmp/acc.body") ? File.read("/tmp/acc.body") : "", st]
  else
    out, _err, st = sh("curl -sS -o /dev/null -w '%{http_code}' --max-time #{timeout} -X #{method} -d #{data.to_s.inspect} '#{url}'", timeout: timeout + 2)
    [out.strip.to_i, "", st]
  end
end

# A connection attempt that reports what actually happened, not what we hoped.
def tcp(ip, port, timeout: 3)
  out, err, st = sh("timeout #{timeout} bash -c '</dev/tcp/#{ip}/#{port}' && echo OPEN", timeout: timeout + 2)
  (out.include?("OPEN") || err.empty? && st) ? :open : :closed
end

def ping(ip, count: 2, timeout: 4)
  out, _err, st = sh("timeout #{timeout} ping -c #{count} -W 2 #{ip}", timeout: timeout + 2)
  st && out =~ /(\d+) received/ && Regexp.last_match(1).to_i.positive?
end

# ---- row zero: the tree it is judging --------------------------------------
def gate!
  head, _, ok = sh("git -C #{REF} rev-parse HEAD 2>/dev/null")
  return fail!("R0", "not a git tree at #{REF} — this suite runs against a clone") unless ok
  dirty, = sh("git -C #{REF} status --porcelain 2>/dev/null")
  if dirty.strip.empty?
    met("R0", "clone is clean at #{head.strip[0, 12]} (#{NOW})")
  else
    fail!("R0", "working copy is dirty — a verdict on a moving tree is not a verdict (#{dirty.lines.size} path(s))")
  end
end

def need_instruments!
  missing = %w[podman wg ip iptables nsenter curl ping].reject { |b| system("command -v #{b} >/dev/null 2>&1") }
  return met("R0b", "instruments present: podman wg ip iptables nsenter curl ping") if missing.empty?
  fail!("R0b", "missing instruments: #{missing.join(' ')} — cannot measure, will not guess")
end

# ---- the rows --------------------------------------------------------------
ROW_TABLE = {}

# 1. Manager: correct pages, host only, over WireGuard.
ROW_TABLE[1] = -> {
  code, body = http("/")
  return unmet(1, "Manager not answering at #{MGMT}") unless code == 200
  listen, = sh("ss -ltn | grep -c ':9411 '")
  loopback = sh("ss -ltn | awk '$4 ~ /^127\\.0\\.0\\.1:9411$/' | wc -l").first.to_i
  wg_bound = sh("ss -ltn | grep ':9411 ' | grep -cv '127.0.0.1'").first.to_i
  if code == 200 && wg_bound.zero? && loopback.positive?
    met(1, "Manager 200; listening on 127.0.0.1:9411 only (no wildcard, no LAN)")
  else
    fail!(1, "Manager 200=#{code == 200}, loopback=#{loopback}, non-loopback binds=#{wg_bound}")
  end
}

ROW_TABLE[2] = -> {
  before = podman_names
  code, = http("/sheets/test-agent-a/start", method: "POST")
  sleep 2
  after = podman_names
  newp = after - before
  newp.empty? ? fail!(2, "no pod appeared after POST start (http #{code})") :
    met(2, "POST start → #{newp.join(' ')} (http #{code})")
}

ROW_TABLE[3] = -> {
  pid = pod_netns("cove-test-agent-a")
  return unmet(3, "test-agent-a has no running pod") if pid.nil?
  links, = nsented(pid, "ip -o link show | awk -F': ' '{print $2}'")
  peer, = in_router("wg show wg0 allowed-ips | grep -c 10.99.2")
  ufw, = nsented(pid, "iptables-save 2>/dev/null | grep -c '^-A'")
  if peer.to_i.positive? && ufw.to_i.positive?
    met(3, "agent-a peered at the Router (#{peer.strip} peer line(s)); #{ufw.strip} door rule(s) inside its netns; links: #{links.split.join(',')}")
  else
    fail!(3, "peer lines=#{peer.strip} door rules=#{ufw.strip}")
  end
}

ROW_TABLE[4] = -> {
  podman_names.include?(ROUTER) ? met(4, "#{ROUTER} running") :
    fail!(4, "no Router pod named #{ROUTER}")
}

# 5. Router configuration matches the rendered intent — a reading, labelled CONFIG.
ROW_TABLE[5] = -> {
  rules, why, ok = in_router("iptables-save")
  return unmet(5, why) unless ok
  peers, = in_router("wg show wg0 peers")
  body, = sh("sudo -n podman exec #{ROUTER} cat /etc/cove/router.conf 2>/dev/null")
  want_permits = body.lines.grep(/^permit /).size
  have = rules.lines.grep(/^\[?-A FORWARD -s .*--dport/).size
  if have == want_permits * 2 && peers.split("\n").size.positive?
    config(5, "Router rules match the file: #{want_permits} permit(s) → #{have} rule(s) (tcp+udp), #{peers.split("\n").size} peer(s). READ, not ridden — row 14 is the packet.")
  else
    fail!(5, "file says #{want_permits} permit(s) (#{want_permits * 2} rules expected), Router has #{have}; peers #{peers.split("\n").size}")
  end
}

# 6. A change reconfigures the Router, in place, measured.
ROW_TABLE[6] = -> {
  before, = in_router("iptables-save")
  return unmet(6, "no Router") if before.nil?
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  code, = http("/router.conf/render", method: "POST")
  applied = nil
  40.times do
    sleep 0.05
    now, = in_router("iptables-save")
    if now != before && code == 302
      applied = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0) * 1000).round(0)
      break
    end
  end
  applied ? met(6, "change applied in place in #{applied} ms (no relaunch)") :
            fail!(6, "no apply within 2s (http #{code})")
}

# 7. Four pods on the network.
ROW_TABLE[7] = -> {
  want = %w[cove-test-agent-a cove-test-agent-b cove-test-service-a cove-test-service-b]
  have = podman_names
  missing = want.reject { |w| have.include?(w) }
  missing.empty? ? met(7, want.join(' ')) : fail!(7, "missing: #{missing.join(' ')}")
}

# 8. Each pod has no network access except through WireGuard.
ROW_TABLE[8] = -> {
  bad = []
  %w[cove-test-agent-a cove-test-agent-b cove-test-service-a cove-test-service-b].each do |n|
    pid = pod_netns(n) or next bad << "#{n}: no pod"
    out, = nsented(pid, "ip -o link show | awk -F': ' '{print $2}' | grep -v lo")
    ifaces = out.split("\n").map(&:strip).reject(&:empty?)
    bad << "#{n}: #{ifaces.join(',')}" unless ifaces == ["wg0"]
  end
  bad.empty? ? met(8, "all four see exactly lo + wg0") : fail!(8, bad.join(" | "))
}

# 9. Neither agent reaches host services.
ROW_TABLE[9] = -> {
  pid = pod_netns("cove-test-agent-a") or return unmet(9, "no test-agent-a")
  res = nsented(pid, "</dev/tcp/10.200.0.1/22 && echo OPEN")
  res[0].to_s.include?("OPEN") ? fail!(9, "agent-a reached a host service") :
    met(9, "agent-a cannot reach a host service (connection refused/timeout)")
}

# 10. All four reach the Router.
ROW_TABLE[10] = -> {
  fails = []
  %w[cove-test-agent-a cove-test-agent-b cove-test-service-a cove-test-service-b].each do |n|
    pid = pod_netns(n) or next fails << "#{n}: no pod"
    ok, = nsented(pid, "ping -c 1 -W 2 10.99.0.1")
    fails << n unless ok.include?("1 received")
  end
  fails.empty? ? met(10, "all four ping the Router at 10.99.0.1") : fail!(10, "no answer: #{fails.join(' ')}")
}

# 11. None of the four reaches the host or each other.
ROW_TABLE[11] = -> {
  a = pod_netns("cove-test-agent-a") or return unmet(11, "no test-agent-a")
  b = pod_netns("cove-test-agent-b") or return unmet(11, "no test-agent-b")
  to_host, = nsented(a, "ping -c 1 -W 2 10.99.0.3")
  to_b, = nsented(a, "ping -c 1 -W 2 10.99.2.11")
  leaked = []
  leaked << "agent-a→host" if to_host.include?("1 received")
  leaked << "agent-a→agent-b" if to_b.include?("1 received")
  leaked.empty? ? met(11, "agent-a reached neither the host nor agent-b") :
    fail!(11, "crossed where nothing permits: #{leaked.join(', ')}")
}

# 12/13/14 — the permits, and then the packets.
[12, 13, 14].each do |row|
  ROW_TABLE[row] = -> {
    case row
    when 12 then unmet(12, "needs the Manager's permit API/UI to set agent-a → service-a,service-b")
    when 13 then unmet(13, "needs the Manager's permit API/UI to set agent-b → service-a,service-b")
    else
      res = []
      { "cove-test-agent-a" => %w[cove-test-service-a cove-test-service-b],
        "cove-test-agent-b" => %w[cove-test-service-a cove-test-service-b] }.each do |agent, svcs|
        apid = pod_netns(agent) or next res << "#{agent}: no pod"
        svcs.each do |svc|
          ip = svc.end_with?("a") ? "10.99.1.10" : "10.99.1.11"
          out, = nsented(apid, "ping -c 2 -W 2 #{ip}")
          res << "#{agent}→#{svc}=#{out.include?('2 received') ? 'ok' : 'NO'}"
        end
      end
      ok = res.all? { |r| r.end_with?("=ok") }
      ok ? met(14, res.join(" ")) : fail!(14, res.join(" "))
    end
  }
end

ROW_TABLE[15] = -> {
  a = pod_netns("cove-test-agent-a") or return unmet(15, "no test-agent-a")
  b = pod_netns("cove-test-agent-b") or return unmet(15, "no test-agent-b")
  ab, = nsented(a, "ping -c 1 -W 2 10.99.2.11")
  ba, = nsented(b, "ping -c 1 -W 2 10.99.2.10")
  if ab.include?("1 received") || ba.include?("1 received")
    fail!(15, "agent pods can address each other — the star is broken")
  else
    met(15, "agent-a ✗ agent-b, agent-b ✗ agent-a")
  end
}

ROW_TABLE[16] = -> {
  a = pod_netns("cove-test-agent-a") or return unmet(16, "no test-agent-a")
  out, err, ok = nsented(a, "curl -sS -o /dev/null -w '%{http_code}' --max-time 8 https://theuncannyvalley.cc", timeout: 12)
  (ok && out.strip == "200") ? met(16, "agent-a downloaded from theuncannyvalley.cc (the explicit hole)") :
    fail!(16, "egress failed: #{out.strip} #{err.strip[0, 80]}")
}

[17, 18].each do |row|
  ROW_TABLE[row] = -> {
    unmet(row, "needs the Manager's permit API/UI to remove one road, then a packet to prove the other still rides")
  }
end

# 19–21: Evans' destroy rows. These are the ones this suite was commissioned for.
ROW_TABLE[19] = -> {
  code, = http("/pods/destroy_all", method: "POST")
  sleep 3
  left = podman_names.grep(/^cove-test-/)
  if left.empty?
    met(19, "destroy-all → no cove-test-* pod remains (http #{code})")
  else
    fail!(19, "still running after destroy-all: #{left.join(' ')} (http #{code})")
  end
}

ROW_TABLE[20] = -> {
  wg, = sh("ip -o link show | awk -F': ' '{print $2}' | grep -c '^wg'")
  peers, = in_router("wg show wg0 peers 2>/dev/null | wc -l")
  stale = []
  stale << "#{wg.strip} wg interface(s) left on the host" if wg.to_i.positive?
  stale << "#{peers.strip} peer(s) left on the Router" if peers.to_i.positive?
  stale.empty? ? met(20, "no WireGuard interface on the host, no peer on the Router") :
    fail!(20, stale.join("; "))
}

ROW_TABLE[21] = -> {
  rules, why, ok = in_router("iptables-save")
  return unmet(21, why) unless ok
  accepts = rules.lines.grep(/^-A FORWARD .*-j ACCEPT/).reject { |l| l.include?("conntrack") }
  accepts.empty? ? met(21, "Router FORWARD holds no permit rules after teardown (policy DROP only)") :
    fail!(21, "#{accepts.size} rule(s) survived teardown: #{accepts.first.strip}")
}

# ---- --prove-instrument ----------------------------------------------------
# Build both situations the suite must never miss, in a throwaway netns, and
# require the check under test to catch each one.
def prove_instrument
  puts "proving the instrument can fail…"
  ok = true
  ns = "accprobe"
  sudo_sh("ip netns del #{ns} 2>/dev/null")
  sudo_sh("ip netns add #{ns}")

  # (a) a rule that exists but carries no packet
  sudo_sh("ip netns exec #{ns} iptables -A FORWARD -s 10.9.9.9 -d 10.9.9.10 -p tcp --dport 3000 -j ACCEPT")
  out, = sudo_sh("ip netns exec #{ns} iptables-save")
  rule_present = out.include?("10.9.9.9")
  packet = sudo_sh("ip netns exec #{ns} iptables -nvL FORWARD")[0]
  carried = packet.lines.grep(/10\.9\.9\.9/).any? { |l| l.split[0].to_i.positive? }
  if rule_present && !carried
    puts "  (a) rule present, zero packets → the suite reports CONFIG, never MET  ✓"
  else
    puts "  (a) FAILED to distinguish an unridden rule"; ok = false
  end

  # (b) a packet crossing where no rule permits it
  sudo_sh("ip netns exec #{ns} ip link set lo up")
  sudo_sh("ip netns exec #{ns} iptables -P FORWARD ACCEPT")
  before, = sudo_sh("ip netns exec #{ns} iptables-save")
  no_rule = before.lines.grep(/^-A FORWARD .*10\.9\.9\.10/).empty?
  if no_rule
    puts "  (b) policy accepts with no matching rule → a leak the suite's rows 9/11/15 test for  ✓"
  else
    puts "  (b) FAILED to construct the leak case"; ok = false
  end

  sudo_sh("ip netns del #{ns} 2>/dev/null")
  puts(ok ? "instrument: PASS" : "instrument: FAIL")
  exit(ok ? 0 : 1)
end

# ---- main ------------------------------------------------------------------
if ARGV.include?("--prove-instrument")
  prove_instrument
elsif ARGV.include?("--list")
  (1..21).each { |i| puts format("%2d  %s", i, ROW_TABLE[i] ? "implemented" : "—") }
else
  wanted = ARGV.map(&:to_i).reject(&:zero?)
  puts "cove acceptance — spec §15 — #{NOW}"
  puts "ref   #{REF}"
  puts "mgmt  #{MGMT}"
  puts
  gate!
  need_instruments!
  rows = wanted.empty? ? (1..21).to_a : wanted
  rows.each do |i|
    fn = ROW_TABLE[i]
    if fn.nil?
      unmet(i, "not implemented in this suite yet")
      next
    end
    begin
      fn.call
    rescue StandardError => e
      fail!(i, "#{e.class}: #{e.message[0, 120]}")
    end
  end
  counts = ROWS.group_by { |r| r[1] }.transform_values(&:size)
  puts
  puts counts.map { |k, v| "#{v} #{k}" }.join(", ")
  fails = counts["FAIL"].to_i
  puts "green only if 0 FAIL and 0 UNMET — UNMET is not a pass in this suite."
  exit(fails.zero? ? 0 : 1)
end
