FROM alpine:3.19

RUN apk add --no-cache \
    wireguard-tools \
    nftables \
    ruby \
    iproute2 \
    curl \
  && gem install webrick --no-doc

COPY src/ /opt/router/src/
COPY entrypoint.sh /opt/router/entrypoint.sh
RUN chmod +x /opt/router/entrypoint.sh

# No config and no WG key in the image. The Manager renders both at
# boot and mounts its runtime directory read-only at /etc/router:
#   config.yml   — rendered per boot (per-boot Manager/Hub pubkeys)
#   private.key  — generated per boot, never baked
# Manual runs must supply the same mount; the entrypoint refuses to start
# without it (a Router with no key is a silent failure, not a default).

WORKDIR /opt/router

# /data is NOT mounted. State is ephemeral — the Manager
# re-registers agents on every boot.

EXPOSE 51820/udp 8080/tcp

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/opt/router/entrypoint.sh"]

# Launched by the Manager's entrypoint with the boot's runtime dir.
# Manual run (for testing):
#   podman run \
#     --cap-add=NET_ADMIN \
#     --cap-add=NET_RAW \
#     --sysctl net.ipv4.ip_forward=1 \
#     --ip 10.88.0.20 \
#     -v /var/lib/neoclaw/spawn/runtime/router:/etc/router:ro \
#     --name wg-router \
#     localhost/neoclaw-router:latest
