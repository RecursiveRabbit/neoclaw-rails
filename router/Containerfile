FROM alpine:3.19

RUN apk add --no-cache \
    wireguard-tools \
    nftables \
    ruby \
    iproute2 \
    curl \
  && gem install webrick --no-doc

COPY src/ /opt/router/src/
COPY entrypoint.sh /opt/router/entrypoint.sh
RUN chmod +x /opt/router/entrypoint.sh

# Config and WG key baked at build time by build.sh.
# No runtime mounts needed for these.
COPY config/ /etc/router/
COPY wg-private.key /etc/wireguard/private.key
RUN chmod 600 /etc/wireguard/private.key

WORKDIR /opt/router

# /data is NOT mounted. State is ephemeral — the Manager
# re-registers agents on every boot.

EXPOSE 51820/udp 8080/tcp

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/opt/router/entrypoint.sh"]

# Launched by the Manager's entrypoint. All keys baked in.
# Manual run (for testing):
#   podman run \
#     --cap-add=NET_ADMIN \
#     --cap-add=NET_RAW \
#     --sysctl net.ipv4.ip_forward=1 \
#     --ip 10.88.0.20 \
#     --name wg-router \
#     localhost/neoclaw-router:latest
