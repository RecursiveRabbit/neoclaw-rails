# NeoClaw Router — dumb WireGuard + iptables forwarder.
#
# No Ruby. No HTTP API. No health endpoint. No agent registry, service
# registry, or persistent control-plane state. The container applies the
# network instructions the Manager mounts at /etc/neoclaw and then holds
# still. See router/router.md for the contract.
#
# Manager-provided files (mounted read-only at runtime):
#   /etc/neoclaw/network.json   — interface, address, peers, routes, rules
#   /etc/neoclaw/router.key     — Router WireGuard private key (Manager-held)
#
# Nothing is baked into the image. A roll is: re-render the same desired
# state, remove the old container, run a new one.

FROM alpine:3.19

RUN apk add --no-cache \
    wireguard-tools \
    iptables \
    iproute2 \
    jq

COPY entrypoint.sh /opt/router/entrypoint.sh
RUN chmod 755 /opt/router/entrypoint.sh

# No EXPOSE: the Router listens for nothing. WireGuard receives inbound
# UDP on its interface; that is packet behavior, not a service.
# No HEALTHCHECK with curl: health is observed from process, WireGuard,
# and packet behavior outside the container — see router/router.md.

ENTRYPOINT ["/opt/router/entrypoint.sh"]
