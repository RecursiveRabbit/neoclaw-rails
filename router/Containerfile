FROM alpine:3.19

RUN apk add --no-cache \
    wireguard-tools \
    nftables \
    ruby \
    iproute2 \
    curl \
  && gem install webrick --no-doc

COPY src/ /opt/router/src/
COPY entrypoint.sh /opt/router/entrypoint.sh
RUN chmod +x /opt/router/entrypoint.sh

WORKDIR /opt/router

# Volumes:
#   /data              — persistent state (agents.json)
#   /etc/router        — config (config.yml)
#   /etc/wireguard     — WG private key
VOLUME ["/data"]

EXPOSE 51820/udp 8080/tcp

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/opt/router/entrypoint.sh"]

# Run with:
#   podman run \
#     --cap-add=NET_ADMIN \
#     --cap-add=NET_RAW \
#     --sysctl net.ipv4.ip_forward=1 \
#     -v ./config:/etc/router:ro \
#     -v ./data:/data \
#     -v ./keys/router.key:/etc/wireguard/private.key:ro \
#     -p 51820:51820/udp \
#     wg-router
