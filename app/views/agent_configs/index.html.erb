<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-mono text-amber-400">Agent Configs</h1>
  <%= link_to "New", new_agent_config_path, class: "bg-amber-600 hover:bg-amber-500 text-zinc-950 px-3 py-1.5 rounded text-sm font-medium" %>
</div>

<div class="bg-zinc-900 border border-zinc-800 rounded divide-y divide-zinc-800">
  <% @configs.each do |config| %>
    <div class="px-4 py-3 flex items-center justify-between">
      <div>
        <span class="font-mono text-zinc-200"><%= config.identity %></span>
        <% if config.singleton %>
          <span class="text-amber-600 text-xs ml-1">(singleton)</span>
        <% end %>
        <div class="text-zinc-500 text-xs mt-0.5">
          <%= (config.base_services || []).join(", ") %>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-zinc-600 text-xs font-mono"><%= config.model %></span>
        <%= link_to "edit", edit_agent_config_path(config), class: "text-amber-400 hover:text-amber-300 text-xs" %>
      </div>
    </div>
  <% end %>
  <% if @configs.empty? %>
    <div class="px-4 py-3 text-zinc-600 text-sm">No agents configured.</div>
  <% end %>
</div>
