<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-mono text-amber-400"><%= @config.identity %></h1>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_agent_config_path(@config), class: "bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-3 py-1.5 rounded text-sm" %>
    <%= link_to "Back", agent_configs_path, class: "text-zinc-500 hover:text-zinc-400 text-sm" %>
  </div>
</div>

<div class="bg-zinc-900 border border-zinc-800 rounded p-6 space-y-4">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide">Model</div>
      <div class="text-zinc-200 font-mono"><%= @config.model %></div>
    </div>
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide">Repo</div>
      <div class="text-zinc-200 font-mono"><%= @config.repo || "—" %></div>
    </div>
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide">Idle Timeout</div>
      <div class="text-zinc-200 font-mono"><%= @config.idle_timeout %>s</div>
    </div>
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide">Singleton</div>
      <div class="text-zinc-200"><%= @config.singleton? ? "Yes" : "No" %></div>
    </div>
  </div>

  <div>
    <div class="text-zinc-500 text-xs uppercase tracking-wide mb-2">Services</div>
    <div class="flex flex-wrap gap-2">
      <% (@config.base_services || []).each do |svc| %>
        <span class="bg-emerald-900/30 border border-emerald-800 text-emerald-400 px-2 py-0.5 rounded text-xs font-mono"><%= svc %></span>
      <% end %>
      <% if (@config.base_services || []).empty? %>
        <span class="text-zinc-600 text-sm">No services configured</span>
      <% end %>
    </div>
  </div>

  <% if @config.channel_overrides.present? && @config.channel_overrides.any? %>
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide mb-2">Channel Overrides</div>
      <% @config.channel_overrides.each do |channel, services| %>
        <div class="text-zinc-400 text-sm">
          <span class="text-zinc-500">#<%= channel %>:</span>
          <span class="text-amber-400">+<%= services.join(", ") %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @config.notes.present? %>
    <div>
      <div class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Notes</div>
      <div class="text-zinc-400 text-sm"><%= @config.notes %></div>
    </div>
  <% end %>
</div>
