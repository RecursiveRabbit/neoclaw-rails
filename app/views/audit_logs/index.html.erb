<h1 class="text-2xl font-mono text-amber-400 mb-6">Audit Log</h1>

<div class="bg-zinc-900 border border-zinc-800 rounded font-mono text-xs">
  <% @logs.each do |log| %>
    <div class="px-4 py-1.5 border-b border-zinc-800/50 flex gap-3">
      <span class="text-zinc-600 shrink-0 w-20"><%= log.created_at.strftime("%m-%d %H:%M") %></span>
      <span class="text-amber-500 shrink-0 w-28"><%= log.event %></span>
      <span class="text-zinc-300 shrink-0 w-40"><%= log.instance_name %></span>
      <span class="text-zinc-500 shrink-0 w-20"><%= log.identity %></span>
      <span class="text-zinc-600 truncate"><%= log.detail %></span>
    </div>
  <% end %>
  <% if @logs.empty? %>
    <div class="px-4 py-3 text-zinc-600">No audit events.</div>
  <% end %>
</div>
