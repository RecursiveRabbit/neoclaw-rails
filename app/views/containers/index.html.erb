<h1 class="text-2xl font-mono text-amber-400 mb-6">Containers</h1>

<div class="bg-zinc-900 border border-zinc-800 rounded">
  <table class="w-full">
    <thead>
      <tr class="text-zinc-500 text-xs uppercase tracking-wide border-b border-zinc-800">
        <th class="px-4 py-2 text-left">Instance</th>
        <th class="px-4 py-2 text-left">Identity</th>
        <th class="px-4 py-2 text-left">Channel</th>
        <th class="px-4 py-2 text-left">State</th>
        <th class="px-4 py-2 text-left">Context</th>
        <th class="px-4 py-2 text-left">Uptime</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      <% @containers.each do |c| %>
        <tr>
          <td class="px-4 py-2 font-mono text-zinc-200"><%= c.instance_name %></td>
          <td class="px-4 py-2 text-zinc-400"><%= c.identity %></td>
          <td class="px-4 py-2 text-zinc-500">#<%= c.channel %></td>
          <td class="px-4 py-2">
            <% color = case c.state
               when "alive" then "text-emerald-400"
               when "starting" then "text-amber-400"
               when "freezing" then "text-blue-400"
               else "text-zinc-600"
               end %>
            <span class="<%= color %> text-sm"><%= c.state %></span>
          </td>
          <td class="px-4 py-2">
            <div class="flex items-center gap-2">
              <div class="w-20 bg-zinc-800 rounded-full h-1.5">
                <% bar_color = c.context_usage > 0.8 ? "bg-red-500" : c.context_usage > 0.5 ? "bg-amber-500" : "bg-emerald-500" %>
                <div class="<%= bar_color %> h-1.5 rounded-full" style="width: <%= c.context_percent %>%"></div>
              </div>
              <span class="text-zinc-500 text-xs font-mono"><%= c.context_percent %>%</span>
            </div>
          </td>
          <td class="px-4 py-2 text-zinc-500 text-sm font-mono">
            <% h, remainder = c.uptime.divmod(3600); m = (remainder / 60).to_i %>
            <%= "#{h.to_i}h#{m.to_s.rjust(2, '0')}m" %>
          </td>
          <td class="px-4 py-2 text-right">
            <% if c.alive? %>
              <%= link_to "stream", stream_container_path(c), class: "text-amber-400 hover:text-amber-300 text-xs mr-2" %>
              <%= button_to "freeze", freeze_container_path(c), class: "text-zinc-400 hover:text-zinc-300 text-xs mr-2" %>
              <%= button_to "kill", kill_container_path(c), class: "text-red-500 hover:text-red-400 text-xs", data: { turbo_confirm: "Kill?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @containers.empty? %>
        <tr>
          <td colspan="7" class="px-4 py-4 text-zinc-600 text-sm text-center">No containers.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
