<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-2xl font-mono text-amber-400"><%= @container.instance_name %></h1>
    <div class="text-zinc-500 text-sm">
      <%= @container.identity %> in #<%= @container.channel %>
      &mdash; context: <span id="context-pct"><%= @container.context_percent %></span>%
    </div>
  </div>
  <div class="flex gap-3">
    <%= button_to "Freeze", freeze_container_path(@container), class: "bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-3 py-1.5 rounded text-sm" %>
    <%= button_to "Kill", kill_container_path(@container), method: :post, class: "bg-red-900 hover:bg-red-800 text-red-200 px-3 py-1.5 rounded text-sm", data: { turbo_confirm: "Kill #{@container.instance_name}?" } %>
    <%= link_to "Back", containers_path, class: "text-zinc-500 hover:text-zinc-400 text-sm py-1.5" %>
  </div>
</div>

<!-- Live stream -->
<div id="stream"
     class="bg-zinc-950 border border-zinc-800 rounded font-mono text-sm overflow-y-auto"
     style="height: calc(100vh - 200px);"
     data-controller="stream"
     data-stream-instance-value="<%= @container.instance_name %>">

  <div class="px-4 py-2 text-zinc-600 border-b border-zinc-900">
    Connecting to <%= @container.instance_name %>...
  </div>
</div>

<script type="module">
  import consumer from "channels/consumer"

  const instance = "<%= @container.instance_name %>"
  const streamEl = document.getElementById("stream")

  consumer.subscriptions.create(
    { channel: "ContainerStreamChannel", instance: instance },
    {
      connected() {
        streamEl.innerHTML = '<div class="px-4 py-2 text-emerald-600 border-b border-zinc-900">Connected. Streaming live output...</div>'
      },

      disconnected() {
        appendLine("stream-disconnect", "Disconnected.", "text-red-500")
      },

      received(raw) {
        try {
          const data = typeof raw === "string" ? JSON.parse(raw) : raw
          renderEvent(data)
        } catch(e) {
          appendLine("stream-raw", raw, "text-zinc-500")
        }
      }
    }
  )

  function renderEvent(data) {
    const type = data.type || "unknown"

    switch(type) {
      case "thinking":
        appendLine("thinking", data.thinking || data.content || "", "text-purple-400 opacity-70 italic")
        break

      case "tool_use":
        const name = data.name || "unknown_tool"
        const input = data.input ? JSON.stringify(data.input).slice(0, 200) : ""
        appendLine("tool", `[${name}] ${input}`, "text-amber-500")
        break

      case "tool_result":
        const preview = (data.output || data.content || "").slice(0, 100)
        appendLine("result", `  → ${preview}`, "text-zinc-600")
        break

      case "text":
      case "content_block_delta":
        appendLine("text", data.text || data.content || "", "text-zinc-200")
        break

      case "result":
        appendLine("result", data.result || data.content || "", "text-emerald-400")
        break

      case "assistant":
        // Full assistant message — extract content blocks
        const msg = data.message || data
        const content = msg.content || []
        if (Array.isArray(content)) {
          content.forEach(block => renderEvent(block))
        }
        // Update context
        const usage = msg.usage || data.usage
        if (usage) {
          const total = (usage.input_tokens || 0) + (usage.cache_creation_input_tokens || 0) + (usage.cache_read_input_tokens || 0)
          const pct = ((total / 200000) * 100).toFixed(1)
          const el = document.getElementById("context-pct")
          if (el) el.textContent = pct
        }
        break

      default:
        if (data.content || data.text) {
          appendLine(type, data.content || data.text, "text-zinc-400")
        }
    }
  }

  function appendLine(type, content, colorClass) {
    if (!content) return
    const div = document.createElement("div")
    div.className = `px-4 py-0.5 ${colorClass} border-b border-zinc-900/30`

    // Truncate very long lines
    const text = content.length > 500 ? content.slice(0, 500) + "..." : content
    div.textContent = text
    streamEl.appendChild(div)
    streamEl.scrollTop = streamEl.scrollHeight
  }
</script>
